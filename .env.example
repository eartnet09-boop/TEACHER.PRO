# ===========================================================
# English Teacher Agent - Variáveis de Ambiente
# ===========================================================
# Copie este arquivo para .env e configure suas variáveis
# comando: cp .env.example .env

# Servidor
HOST=0.0.0.0
PORT=8000
RELOAD=false
WORKERS=1

# Dispositivo para ML (cpu ou cuda)
DEVICE=cpu

# Ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5-coder:3b

# TTS (edge ou gtts)
TTS_ENGINE=edge
TTS_VOICE=en-US-AriaNeural
TTS_RATE=1.0

# Logging
LOG_LEVEL=INFO

# Caminhos
MODELS_PATH=./models
TEMP_PATH=./temp

# Segurança (não use este valor em produção!)
SECRET_KEY=change-this-in-production
ALLOWED_ORIGINS=*